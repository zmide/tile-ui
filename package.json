{
	"name": "tile-ui",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "TURBO_TELEMETRY_DISABLED=1 turbo dev",
		"build": "TURBO_TELEMETRY_DISABLED=1 turbo build",
		"lint": "TURBO_TELEMETRY_DISABLED=1 turbo lint && oxfmt --check .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"check": "pnpm lint && pnpm type:check",
		"type:check": "pnpm --filter @tile-ui/core type:check && pnpm --filter @tile-ui/react type:check && pnpm --filter @tile-ui/vue type:check && pnpm --filter @tile-ui/solid type:check && pnpm --filter @tile-ui/styles type:check && pnpm --filter @tile-ui/react-docs type:check && pnpm --filter @tile-ui/vue-docs type:check && pnpm --filter @tile-ui/solid-docs type:check",
		"clean": "TURBO_TELEMETRY_DISABLED=1 turbo clean",
		"registry:build:react": "pnpm --filter @tile-ui/react-docs registry:build",
		"registry:build:vue": "pnpm --filter @tile-ui/vue-docs registry:build",
		"registry:build:solid": "pnpm --filter @tile-ui/solid-docs registry:build",
		"registry:build": "pnpm registry:build:react && pnpm registry:build:vue && pnpm registry:build:solid",
		"generated:check": "node scripts/check-generated.mjs",
		"docs:check": "node scripts/check-docs.mjs",
		"parity:check": "node scripts/check-parity.mjs",
		"package:check": "node scripts/package-check.mjs",
		"browser:smoke": "node scripts/browser-check.mjs smoke",
		"accessibility:check": "node scripts/browser-check.mjs accessibility",
		"memory:check": "node scripts/browser-check.mjs memory",
		"liveline:visual": "node scripts/liveline-visual.mjs",
		"theme:check": "pnpm test:themes",
		"theme:styles": "node --test packages/styles/test/*.test.mjs",
		"theme:visual": "node scripts/theme-visual.mjs",
		"theme:reference": "pnpm --filter @tile-ui/theme-kumo test:reference",
		"test": "pnpm test:core && pnpm test:themes && pnpm test:buildx && pnpm test:react && pnpm test:vue && pnpm test:solid",
		"test:core": "pnpm --filter @tile-ui/core test",
		"test:buildx": "pnpm --filter @tile-ui/buildx test",
		"test:react": "pnpm --filter @tile-ui/react test",
		"test:vue": "pnpm --filter @tile-ui/vue test",
		"test:solid": "pnpm --filter @tile-ui/solid test",
		"release": "node scripts/release.mjs",
		"test:themes": "pnpm --filter @tile-ui/theme-kumo test"
	},
	"devDependencies": {
		"axe-core": "^4.10.3",
		"chrome-launcher": "^1.2.1",
		"lighthouse": "^12.8.2",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.18.0",
		"playwright": "^1.55.0",
		"release-it": "^21.0.2",
		"turbo": "^2.4.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@9.15.0"
}
