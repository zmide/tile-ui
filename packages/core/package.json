{
	"name": "@tile-ui/core",
	"version": "1.1.4",
	"private": false,
	"description": "Framework-agnostic logic and types for the Tile UI design system",
	"keywords": [
		"components",
		"design-system",
		"logic",
		"types",
		"ui"
	],
	"homepage": "https://github.com/zmide/tile-ui/tree/master/packages/core",
	"bugs": {
		"url": "https://github.com/zmide/tile-ui/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/zmide/tile-ui.git",
		"directory": "packages/core"
	},
	"files": [
		"LICENSE",
		"README.md",
		"README.zh-CN.md",
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./utils": {
			"import": {
				"types": "./dist/utils/index.d.ts",
				"default": "./dist/utils/index.js"
			},
			"require": {
				"types": "./dist/utils/index.d.cts",
				"default": "./dist/utils/index.cjs"
			}
		},
		"./tokens": {
			"import": {
				"types": "./dist/tokens/index.d.ts",
				"default": "./dist/tokens/index.js"
			},
			"require": {
				"types": "./dist/tokens/index.d.cts",
				"default": "./dist/tokens/index.cjs"
			}
		},
		"./liveline": {
			"import": {
				"types": "./dist/liveline/index.d.ts",
				"default": "./dist/liveline/index.js"
			},
			"require": {
				"types": "./dist/liveline/index.d.cts",
				"default": "./dist/liveline/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "oxlint -c .oxlintrc.json .",
		"type:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -rf dist",
		"release": "release-it"
	},
	"devDependencies": {
		"@typescript/native": "npm:typescript@^7.0.2",
		"tsup": "^8.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^3.2.4"
	}
}
