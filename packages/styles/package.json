{
	"name": "@tile-ui/styles",
	"version": "1.1.4",
	"private": false,
	"description": "Shared SCSS design system and generated CSS for the Tile UI components",
	"keywords": [
		"components",
		"css",
		"design-system",
		"scss",
		"styles",
		"ui"
	],
	"homepage": "https://github.com/zmide/tile-ui/tree/main/packages/styles",
	"bugs": {
		"url": "https://github.com/zmide/tile-ui/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/zmide/tile-ui.git",
		"directory": "packages/styles"
	},
	"files": [
		"LICENSE",
		"README.md",
		"README.zh-CN.md",
		"scss",
		"css"
	],
	"type": "module",
	"exports": {
		"./scss/*": "./scss/*",
		"./css/*": "./css/*",
		"./tokens.scss": "./scss/tokens.scss",
		"./tokens.css": "./css/tokens.css",
		"./theme.scss": "./scss/theme.scss",
		"./theme.css": "./css/theme.css",
		"./reset.scss": "./scss/reset.scss",
		"./reset.css": "./css/reset.css",
		"./globals.scss": "./scss/globals.scss",
		"./globals.css": "./css/globals.css"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node build.js",
		"generated:check": "node check-generated.mjs",
		"lint": "oxlint -c .oxlintrc.json .",
		"type:check": "node -e \"process.exit(0)\"",
		"clean": "rm -rf css",
		"release": "release-it"
	},
	"devDependencies": {
		"sass": "^1.86.3"
	}
}
