{
	"name": "@tile-ui/vue",
	"version": "1.1.4",
	"private": false,
	"description": "Vue components for the Tile UI design system",
	"keywords": [
		"components",
		"ui",
		"vue",
		"vuejs"
	],
	"homepage": "https://github.com/zmide/tile-ui/tree/master/packages/vue",
	"bugs": {
		"url": "https://github.com/zmide/tile-ui/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/zmide/tile-ui.git",
		"directory": "packages/vue"
	},
	"files": [
		"README.md",
		"README.zh-CN.md",
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./composables": {
			"import": {
				"types": "./dist/composables/index.d.ts",
				"default": "./dist/composables/index.js"
			},
			"require": {
				"types": "./dist/composables/index.d.cts",
				"default": "./dist/composables/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "oxlint -c .oxlintrc.json .",
		"test": "tsc --noEmit -p test/tsconfig.json && vitest run",
		"prepack": "pnpm --dir ../.. --filter @tile-ui/core build && pnpm run build",
		"type:check": "tsc --noEmit",
		"clean": "rm -rf dist",
		"release": "release-it"
	},
	"dependencies": {
		"@tile-ui/core": "workspace:*"
	},
	"devDependencies": {
		"@tile-ui/buildx": "workspace:*",
		"@typescript/native": "npm:typescript@^7.0.2",
		"sass": "^1.86.3",
		"tsup": "^8.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vue": "^3.5.0"
	},
	"peerDependencies": {
		"@tile-ui/styles": "workspace:*",
		"vue": ">=3.3.0"
	}
}
